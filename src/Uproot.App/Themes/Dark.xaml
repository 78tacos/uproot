<!--
    Dark palette. Light.xaml defines the same keys with light values; ThemeManager swaps
    whichever of the two sits at index 0 of the application's merged dictionaries.

    Every brush the styles reference must exist in BOTH files, or a theme switch will leave
    dangling DynamicResource lookups that silently render as transparent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface" Color="#FF16181D" />
    <SolidColorBrush x:Key="SurfacePanel" Color="#FF1B1E24" />
    <SolidColorBrush x:Key="SurfaceRow" Color="#FF20242C" />
    <SolidColorBrush x:Key="SurfaceRowHover" Color="#FF272C36" />
    <SolidColorBrush x:Key="SurfaceRowSelected" Color="#FF2F3644" />
    <SolidColorBrush x:Key="Divider" Color="#FF2C313B" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFE8EAF0" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA2B1" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF6C7488" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF6E9BF2" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FF4A7BD8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />

    <!-- Label tones -->
    <SolidColorBrush x:Key="ToneNeutralBg" Color="#FF2A2F39" />
    <SolidColorBrush x:Key="ToneNeutralFg" Color="#FFAEB6C4" />
    <SolidColorBrush x:Key="ToneInfoBg" Color="#FF1E3352" />
    <SolidColorBrush x:Key="ToneInfoFg" Color="#FF8FB8F5" />
    <SolidColorBrush x:Key="ToneSuccessBg" Color="#FF16371F" />
    <SolidColorBrush x:Key="ToneSuccessFg" Color="#FF77D58F" />
    <SolidColorBrush x:Key="ToneWarningBg" Color="#FF43320F" />
    <SolidColorBrush x:Key="ToneWarningFg" Color="#FFE8B65C" />
    <SolidColorBrush x:Key="ToneDangerBg" Color="#FF4A1E1E" />
    <SolidColorBrush x:Key="ToneDangerFg" Color="#FFF2857F" />
    <SolidColorBrush x:Key="ToneCriticalBg" Color="#FFB3261E" />
    <SolidColorBrush x:Key="ToneCriticalFg" Color="#FFFFE9E7" />

    <!-- Component-specific -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF3A4150" />
    <SolidColorBrush x:Key="RowActionBg" Color="#FF323947" />
    <SolidColorBrush x:Key="RowActionBorder" Color="#FF424B5C" />
    <SolidColorBrush x:Key="CtaBg" Color="#FF1F7A3D" />
    <SolidColorBrush x:Key="CtaBorder" Color="#FF2E9E52" />
    <SolidColorBrush x:Key="CtaHover" Color="#FF268C49" />
    <SolidColorBrush x:Key="CtaPressed" Color="#FF1A6633" />

</ResourceDictionary>
