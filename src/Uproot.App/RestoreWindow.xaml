<Window x:Class="Uproot.App.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Uproot.App"
        xmlns:vm="clr-namespace:Uproot.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RestoreViewModel}"
        Title="Restore removed items — Uproot" Height="700" Width="1080" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner" Icon="Assets/app.ico"
        Background="{DynamicResource Surface}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <local:ToneToBackgroundConverter x:Key="ToneBg" />
        <local:ToneToForegroundConverter x:Key="ToneFg" />
        <local:PresenceToVisibilityConverter x:Key="Presence" />

        <DataTemplate x:Key="ChipTemplate">
            <Border Background="{Binding Tone, Converter={StaticResource ToneBg}}"
                    CornerRadius="4" Padding="7,2" Margin="0,0,5,3"
                    ToolTip="{Binding Explanation}" ToolTipService.InitialShowDelay="250">
                <TextBlock Text="{Binding Text}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{Binding Tone, Converter={StaticResource ToneFg}}" />
            </Border>
        </DataTemplate>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,4,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceRow}" CornerRadius="7" Padding="12,9"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRowSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Background="{DynamicResource SurfacePanel}" Padding="22,16"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Restore removed items" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Every removal is backed up. Pick one to see what it took and put any of it back." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Restart as admin" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding RestartAsAdminCommand}"
                            Visibility="{Binding IsElevated, Converter={StaticResource Presence}, ConverterParameter=Invert}"
                            ToolTip="Machine-wide items — HKLM keys, services, firewall rules, Program Files — can only be put back as administrator." />
                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1" Visibility="{Binding HasRemovals, Converter={StaticResource Presence}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Removals}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" Padding="0,6,0,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource RowContainer}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RemovalRowViewModel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,4" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{DynamicResource Divider}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="18,14,18,6">
                    <TextBlock Text="{Binding DetailHeading}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextPrimary}"
                               Visibility="{Binding ResultSummary, Converter={StaticResource Presence}}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="18,4,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Select all" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                                Command="{Binding SelectAllCommand}" />
                        <Button Content="Select none" Style="{StaticResource GhostButton}" Padding="10,5"
                                Command="{Binding SelectNoneCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSummary}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="18,3,14,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{DynamicResource SurfaceRow}" CornerRadius="6" Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RestoreItemRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                          VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding KindName}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Content="{Binding Outcome}" ContentTemplate="{StaticResource ChipTemplate}"
                                                  VerticalAlignment="Top" Margin="10,0,0,0"
                                                  Visibility="{Binding Outcome, Converter={StaticResource Presence}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasRemovals, Converter={StaticResource Presence}, ConverterParameter=Invert}">
            <TextBlock Text="Nothing has been removed yet" Style="{StaticResource H2}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Body}" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Each time leftovers are removed, their backups are kept here so the removal can be undone." />
        </StackPanel>

        <!-- ===================== Footer ===================== -->
        <Border Grid.Row="2" Background="{DynamicResource SurfacePanel}" Padding="22,12"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Open Recycle Bin" Style="{StaticResource GhostButton}" Margin="12,0,8,0"
                            Command="{Binding OpenRecycleBinCommand}" />
                    <Button Content="Open backup folder" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding OpenFolderCommand}" />
                    <Button Content="Close" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" Click="OnClose" />
                    <Button Content="Restore selected" Style="{StaticResource PrimaryButton}" MinWidth="140"
                            Command="{Binding RestoreCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
