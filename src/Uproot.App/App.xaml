<Application x:Class="Uproot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Slot 0 is the colour palette and ThemeManager replaces it wholesale when the
                    theme changes. Keep it first; the styles that follow resolve colours through
                    DynamicResource and will pick up whatever is in this slot.
                -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
