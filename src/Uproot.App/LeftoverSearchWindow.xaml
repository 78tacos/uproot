<Window x:Class="Uproot.App.LeftoverSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find leftovers of a removed program" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Surface}" Icon="Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <StackPanel>
        <StackPanel Margin="22,20,22,16">
            <TextBlock Text="Find leftovers of a removed program" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="For a program that is no longer in the list — uninstalled some other way, or never listed. The scan works from its name and publisher: folders and keys named after it, and scheduled tasks, services and startup entries left pointing at files that are gone." />

            <TextBlock Text="PROGRAM NAME" Style="{StaticResource SectionHeading}" />
            <TextBox x:Name="NameBox" TextChanged="OnTextChanged" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="As it was listed, for example &quot;Adobe Creative Cloud&quot;. A shorter, distinctive name finds more." />

            <TextBlock Text="PUBLISHER (OPTIONAL)" Style="{StaticResource SectionHeading}" />
            <TextBox x:Name="PublisherBox" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Lets the scan look inside the publisher's own folders and keys, such as ProgramData\Adobe." />

            <TextBlock Text="INSTALL FOLDER (OPTIONAL)" Style="{StaticResource SectionHeading}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" TextChanged="OnTextChanged" />
                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButton}" Padding="10,4" Margin="8,0,0,0"
                        Click="OnBrowse" />
            </Grid>
            <TextBlock x:Name="FolderNote" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Where it was installed, if you know. The folder is offered for removal, and anything still pointing into it — shortcuts, startup entries, services, tasks, firewall rules, PATH entries — is found for certain." />
        </StackPanel>

        <Border Background="{DynamicResource SurfacePanel}" Padding="22,14"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="SearchButton" Content="Continue" Style="{StaticResource PrimaryButton}" MinWidth="100"
                        IsDefault="True" IsEnabled="False" Click="OnSearch" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
