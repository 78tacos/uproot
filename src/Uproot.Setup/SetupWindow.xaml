<Window x:Class="Uproot.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uproot setup" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource Surface}" Icon="Assets/app.ico"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,22,24,18">
            <TextBlock x:Name="Heading" Text="Install Uproot" Style="{StaticResource H1}" />
            <TextBlock x:Name="BuildLine" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Uproot uninstalls programs, then finds and removes what their uninstallers leave behind, with a backup of everything it removes." />

            <TextBlock Text="WHAT INSTALLING ADDS" Style="{StaticResource SectionHeading}" />
            <Border Background="{DynamicResource SurfaceRow}" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="FolderLine" Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="A Start menu shortcut for everyone, and an Apps &amp; Features entry to remove it with." />
                    <TextBlock Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="The folder on PATH, so &quot;uproot&quot; works in any new shell." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ExistingLine" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Only administrators can change Program Files, so this copy is the one Uproot restarts with administrator rights. Backups of past removals stay where they are." />

            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <ProgressBar x:Name="WorkingBar" IsIndeterminate="True" Height="4" Margin="0,0,0,10" />
                <TextBlock x:Name="ResultText" Style="{StaticResource Body}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfacePanel}" Padding="24,14"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Cancel" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" IsCancel="True" Click="OnClose" />
                <Button x:Name="ActionButton" Content="Install" Style="{StaticResource PrimaryButton}"
                        MinWidth="110" IsDefault="True" Click="OnAction" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
